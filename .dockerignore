# Allowlist the two offline code-image build contexts. Unlisted host files are
# never sent to the Docker daemon, even if a new model/data directory appears.
*
!pyproject.toml
!README.md
!LICENSE.md
!mineru/
!mineru/**
!scripts/
scripts/*
!scripts/offline_package.py
!docker/
docker/*
!docker/worker/
docker/worker/*
!docker/worker/Dockerfile
!docker/worker/entrypoint.sh
!docker/business-api/
docker/business-api/*
!docker/business-api/Dockerfile
!business-web/
business-web/*
!business-web/dist/
!business-web/dist/**
!wheelhouse/
wheelhouse/*
!wheelhouse/requirements.lock
!wheelhouse/*.whl

# Defense in depth for accidentally placed payloads inside an allowed tree.
**/__pycache__/
**/.git/
**/.venv/
**/node_modules/
**/*.pyc
**/.DS_Store
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.env
**/.env*
**/*.key
**/*.pem
**/*.p12
**/*.pdf
**/*.doc
**/*.docx
**/*.ppt
**/*.pptx
**/*.xls
**/*.xlsx
**/*.ofd
**/*.epub
**/*.zip
**/*.tar
**/*.tar.gz
**/*.safetensors
**/*.gguf
**/*.onnx
**/*.pt
**/*.pth
**/*.ckpt
**/*.bin
